server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # ── Security Headers ────────────────────────────────────────────────────────
  # CATATAN NGINX: add_header di server block TIDAK diwarisi oleh location block
  # yang mendefinisikan add_header sendiri. Karena itu, location = /config.js
  # harus menduplikasi semua header ini (lihat di bawah).
  #
  # Mencegah halaman di-embed sebagai iframe dari domain lain (Clickjacking)
  add_header X-Frame-Options "SAMEORIGIN" always;
  # Mencegah browser menebak content-type (MIME sniffing attack)
  add_header X-Content-Type-Options "nosniff" always;
  # Mengaktifkan proteksi XSS bawaan browser lama
  add_header X-XSS-Protection "1; mode=block" always;
  # Membatasi informasi referrer yang dikirim ke situs lain
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # Menonaktifkan fitur browser yang tidak digunakan
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
  # Content Security Policy:
  # - connect-src menyertakan ${BACKEND_ORIGIN} agar request ke backend Railway
  #   (beda domain) tidak diblokir CSP. Nilai ini di-inject oleh docker-entrypoint.sh
  #   dari env var FRONTEND_API_BASE_URL saat container start.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${BACKEND_ORIGIN}; frame-ancestors 'none';" always;
  # ────────────────────────────────────────────────────────────────────────────

  # config.js berisi API URL yang bisa berubah — wajib no-cache
  # Semua security headers HARUS diulang di sini karena nginx tidak mewarisi
  # add_header dari server block jika location block punya add_header sendiri.
  location = /config.js {
    add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${BACKEND_ORIGIN}; frame-ancestors 'none';" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
