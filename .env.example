# Root .env.example for IT Asset Management System
# Copy this file to .env and fill values. Do NOT commit .env.

# General
ENVIRONMENT=development

# Database
# For production use a secure password and proper host
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@postgres:5432/it_asset_db

# Auth / Security
SECRET_KEY=CHANGE_ME_USE_RANDOM_STRING_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend / CORS (comma-separated list)
# Example: ALLOW_ORIGINS=http://localhost,https://yourdomain.com
ALLOW_ORIGINS=http://localhost
